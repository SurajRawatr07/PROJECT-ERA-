# ProjectVerse 2.0 Environment Configuration Example
# Copy this file to .env and configure with your environment values.

# MongoDB Connection String
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/projectverse?retryWrites=true&w=majority
# Example for local MongoDB: mongodb://localhost:27017/projectverse
MONGODB_URI=mongodb://localhost:27017/projectverse

# JWT Secret Key for Session Authentication
JWT_SECRET=projectverse_jwt_secure_production_secret_change_this

# Server Port
PORT=3000

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:3000
